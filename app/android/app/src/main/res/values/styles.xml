<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Tema base.

      `windowLightStatusBar` NÃO é decoração: com `adjustMarginsForEdgeToEdge:
      'auto'` e targetSdk 36, o Android 15 desenha a barra de status por cima do
      conteúdo do app. A cor dos ícones (relógio, bateria, sinal) vem apenas
      desse atributo; sem ele o padrão é `false` = ícones BRANCOS. Sobre o fundo
      claro do app (#fff4f1) isso dá 1,08:1 — os ícones somem.

      `true` aqui significa "fundo claro, desenhe ícones escuros". Preto sobre
      #fff4f1 = 19,46:1. O par escuro fica em `values-night/`.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Gesto de navegação e barra inferior: ícones escuros também. -->
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/urdumeFundo</item>
    </style>

    <!--
      Splash: o `android:background` do tema aponta para `@color/urdumeFundo`,
      a MESMA cor do a cor de fundo (token background) claro do app (#fff4f1). Antes o PNG do
      splash era #faf7f2 e a transição splash → app piscava num tom diferente.

      `windowLightStatusBar` também aqui: é o tema que está ativo durante o
      splash, e sem ele os ícones apareciam brancos já na abertura.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/urdumeFundo</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
