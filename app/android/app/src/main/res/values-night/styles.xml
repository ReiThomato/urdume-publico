<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Tema escuro (modo noturno do sistema).

      Mesmo princípio do `values/styles.xml`, invertido: o fundo é escuro, então
      a barra de status precisa de ícones CLAROS (`windowLightStatusBar=false`).
      Branco sobre #171211 = 18,57:1; preto sobre #171211 = 1,13:1.

      O app tem tema próprio (claro/escuro escolhido dentro dele), mas o Android
      decide a cor da barra pelo tema DO SISTEMA — por isso o par é necessário
      aqui e não só em JS.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/urdumeFundoEscuro</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/urdumeFundoEscuro</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
