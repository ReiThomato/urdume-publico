<?xml version="1.0" encoding="utf-8"?>
<!--
  Regras de backup do Android (Android 12+, API 31+).

  Por que tudo é excluído: o app guarda tarefas, projetos e páginas num banco
  IndexedDB dentro do WebView. O `android:allowBackup="true"` das versões
  anteriores fazia o Android guardar uma cópia na nuvem/Google Drive e
  RESTAURAR isso automaticamente numa instalação nova.

  O efeito observado: desinstalar, "limpar todos os dados" e reinstalar trazia
  de volta tarefas que o usuário já tinha apagado. Ele não estava vendo cache:
  o sistema devolvia o banco antigo, sem avisar e sem o app pedir.

  Um app cujos dados são "só neste aparelho" (e cujo backup real é o export
  manual em Ajustes) não deve ter restauração automática do sistema. Desligar
  aqui não apaga nada do aparelho: só impede o Android de repor cópias antigas
  na próxima instalação.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
